{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Gateway": {
    "LmStudioBaseUrl": "http://localhost:1234",
    "ModelName": "qwen/qwen3-8b",
    "MaxConcurrency": 1,
    "MaxTokensPerChunk": 1500,
    "MaxResponseTokens": 4000,
    "Temperature": 0.1,
    "ApiKeys": [
      "5992afca-eda0-48db-b366-6b27b27707a8",
      "test-key-dev-only"
    ],
    "CacheDurationMinutes": 60,
    "RequestTimeoutSeconds": 3000,
    "CharsPerToken": 4,
    "MaxQueueSize": 100
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },

  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  }
}
