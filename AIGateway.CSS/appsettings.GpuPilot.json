{
  "Gateway": {
    "LmStudioBaseUrl": "http://127.0.0.1:1234",
    "ModelName": "survey-classifier",
    "MaxConcurrency": 1,
    "Temperature": 0.1,
    "MaxResponseTokens": 1536,
    "ResponseTokenLimits": {
      "codegroup_preselection": 512,
      "code_selection": 1536,
      "single_pass": 1536,
      "candidate_rerank": 1536,
      "chat": 1536
    },
    "RequestTimeoutSeconds": 300
  },
  "Jobs": { "StoragePath": "C:/AI-Gateway/gpu-pilot/css/jobs" },
  "ResultFiles": { "OutputDir": "C:/AI-Gateway/gpu-pilot/css/output" },
  "Storage": { "ResultsPath": "C:/AI-Gateway/gpu-pilot/css/results" },
  "Kestrel": {
    "Endpoints": { "Http": { "Url": "http://127.0.0.1:5001" } }
  }
}
