{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gateway": {
    "LmStudioBaseUrl": "http://localhost:1234",
    "ModelName": "google/gemma-3-4b",
    "MaxConcurrency": 1,
    "Temperature": 0.1,
    "ApiKeys": [
      "css-key-change-me",
      "css-dev-key"
    ],
    "CacheDurationMinutes": 60,
    "RequestTimeoutSeconds": 30000,
    "MaxQueueSize": 100
  },
  "Jobs": {
    "StoragePath": "D:/AI-Gateway/jobs-css"
  },
  "ResultFiles": {
    "OutputDir": "D:/AI-Results-CSS"
  },
  "Storage": {
    "ResultsPath": "D:/AI-Gateway/results-css"
  },
  "CssCodebook": {
    "Path": "Codebooks/css-codes.imported.json",
    "Notes": "Importierte Codeliste aus Word. Diese Datei ist die fachliche Basis fuer das CSS-Projekt."
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "AiGateway.CSS.Api.Middleware.MemoryMonitoringMiddleware": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/css-gateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/css-memory-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "restrictedToMinimumLevel": "Debug",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5001"
      }
    }
  }
}

